{
    "name": "yaleksandr89/archive-guard",
    "description": "Security-first inspection and controlled extraction of untrusted ZIP and TAR archives for PHP.",
    "homepage": "https://github.com/yaleksandr89/archive-guard",
    "keywords": [
        "archive",
        "zip",
        "security",
        "extraction",
        "zip-slip",
        "zip-bomb",
        "tar",
        "gzip",
        "tgz"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "email": "y.aleksandr89@yandex.ru",
            "homepage": "https://github.com/yaleksandr89",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/archive-guard/issues",
        "source": "https://github.com/yaleksandr89/archive-guard"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://boosty.to/backendbezpafosa"
        },
        {
            "type": "other",
            "url": "https://sponsr.ru/backendbezpafosa/"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "ext-zip": "*",
        "ext-zlib": "*",
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.26",
        "phpstan/phpstan": "^2.2.14",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "phpunit/phpunit": "^13.3.4"
    },
    "autoload": {
        "psr-4": {
            "Yaleksandr\\ArchiveGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\ArchiveGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-text --coverage-clover .build/coverage.xml"
        ],
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
